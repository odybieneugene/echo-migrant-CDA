# Modèle de configuration de production. À copier en ".env" (jamais commité : voir .gitignore)
#   cp .env.example .env
# puis remplacer chaque valeur. Le backend REFUSE de démarrer avec des secrets faibles ou de développement.

# Adresse publique du site (sert à la règle CORS du backend)
PUBLIC_URL=https://echo-migrant.exemple.fr

# Port de l'hôte sur lequel nginx écoute (80 en direct, ou 8080 derrière un reverse proxy HTTPS)
HTTP_PORT=80

# Base de données PostgreSQL
DB_NAME=echo_migrant
DB_USER=echo_migrant
# Générer avec :  openssl rand -hex 24
DB_PASSWORD=A_REMPLACER

# Clé de signature des jetons JWT, 32 caractères minimum. Générer avec :  openssl rand -base64 48
# La changer déconnecte tous les utilisateurs (leurs jetons deviennent invalides).
JWT_SECRET=A_REMPLACER

# Premier compte administrateur, créé au premier démarrage seulement (s'il n'existe aucun admin).
# 12 caractères minimum. À changer depuis "Mon compte" après la première connexion.
ADMIN_DEFAULT_EMAIL=admin@exemple.fr
ADMIN_DEFAULT_PASSWORD=A_REMPLACER
